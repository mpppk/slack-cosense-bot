# Copy to .dev.vars for `bun run dev`. In production set these with
# `bunx wrangler secret put <NAME>` — .dev.vars is gitignored and never deployed.

# Slack app credentials (Basic Information → App Credentials, OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Service Account access key for the bot's own account (starts with cs_). The
# Worker keeps this historical secret name, then writes the project-scoped
# ~/.cosense/settings.json entry before invoking the CLI. See README "Cosense の認証".
COSENSE_PAT=...
