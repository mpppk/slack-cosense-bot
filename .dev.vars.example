# Copy to .dev.vars for `bun run dev`. In production set these with
# `bunx wrangler secret put <NAME>` — .dev.vars is gitignored and never deployed.

# Slack app credentials (Basic Information → App Credentials, OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Personal Access Token for the Cosense account used by this bot.
COSENSE_PAT=...
